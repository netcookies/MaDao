{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaDao SMS Platform",
  "version": "0.1.0",
  "identifier": "com.madao.sms",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MaDao SMS Platform",
        "width": 1024,
        "height": 768,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../config/server.toml": "defaults/config/server.toml",
      "../plugins/providers/": "defaults/providers/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
